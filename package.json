{
  "name": "glyphcast",
  "version": "0.4.1",
  "description": "Video as colored glyphs: a complete WebGL2 player with controls and PiP, and a glyph stream a server can send instead of video",
  "keywords": [
    "ascii",
    "ascii-art",
    "video",
    "player",
    "webgl",
    "canvas",
    "streaming",
    "glyph",
    "terminal",
    "typescript"
  ],
  "license": "MIT",
  "author": "MrProLopstar",
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "glyphcast": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "README.ru.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrProLopstar/glyphcast.git"
  },
  "homepage": "https://github.com/MrProLopstar/glyphcast#readme",
  "bugs": {
    "url": "https://github.com/MrProLopstar/glyphcast/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
